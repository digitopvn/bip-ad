{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bip-ad",
  "account_id": "009dc0fcd0da3e503fbf38eb2b586e4b",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "bip-ad", "database_id": "c3c2be94-1aab-419b-ac9f-c68b84a9308b", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "99ed5f2116484791ab66e90e298cff89" }],
  // Cloudflare Email Service: transactional email (welcome, receipts, moderation decisions, lock results).
  "send_email": [{ "name": "EMAIL", "remote": true }],
  // 03:12 ICT (UTC+7, no DST) = 20:12 UTC on the previous day. The hourly run vests commissions, expires quotes and catches up a missed lock (idempotent).
  // The 15-minute run only sends email, in its own invocation so it never shares the D1 query limit with the lock. Environments inherit these triggers.
  "triggers": { "crons": ["12 20 * * *", "40 * * * *", "*/15 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://bip-ad.digitop-vn.workers.dev",
    "PAYMENT_MODE": "simulated",
    "LIVE_PAYMENTS": "false",
    "MIN_BID_UNITS": "100",
    "MIN_BID_INCREMENT_UNITS": "100",
    "FX_USD_VND": "25400",
    "QUOTE_TTL_SECONDS": "900",
    "REFERRAL_HOLD_DAYS": "30",
    "REFERRAL_ATTRIBUTION_DAYS": "30",
    "MIN_PAYOUT_USD_CENTS": "1000",
    "MIN_PAYOUT_VND": "250000",
    // AI moderation scores every submission and edit; low-risk ones publish automatically (see ADR-0008).
    "MODERATION_MODE": "ai",
    "MODERATION_DECISION_PROVIDER": "cloudflare",
    "MODERATION_DECISION_MODEL_FAST": "clef",
    "MODERATION_DECISION_MODEL": "clef",
    "MODERATION_LLM_PROVIDER": "cloudflare",
    "MODERATION_LLM_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "MODERATION_APPROVE_MAX_RISK": "0.3",
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    "SEPAY_API_BASE": "https://pgapi-sandbox.sepay.vn",
    "SEPAY_CHECKOUT_URL": "https://pay-sandbox.sepay.vn/v1/checkout/init",
    // Sender of transactional email and its Reply-To. hello@bip.ad is a real inbox (Email Routing forwards it).
    "EMAIL_FROM": "bip.ad <hello@bip.ad>",
    "EMAIL_REPLY_TO": "hello@bip.ad"
  },
  "observability": { "enabled": true },

  // Top-level config above is STAGING (deployed from the `dev` branch, plain `wrangler deploy`).
  // Production is deployed with `--env production` from the `main` branch.
  // Bindings and vars are not inherited by environments, so production restates them all.
  "env": {
    "production": {
      "name": "bip-ad-production",
      "workers_dev": false,
      "routes": [
        { "pattern": "bip.ad", "custom_domain": true },
        { "pattern": "www.bip.ad", "custom_domain": true }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "bip-ad-production", "database_id": "d598eb40-7a02-4dad-8276-54e358006943", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "151153360d7e4e0caa3366e7f3d6531b" }],
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "vars": {
        "PUBLIC_ORIGIN": "https://bip.ad",
        "PAYMENT_MODE": "simulated",
        "LIVE_PAYMENTS": "false",
        "MIN_BID_UNITS": "100",
        "MIN_BID_INCREMENT_UNITS": "100",
        "FX_USD_VND": "25400",
        "QUOTE_TTL_SECONDS": "900",
        "REFERRAL_HOLD_DAYS": "30",
        "REFERRAL_ATTRIBUTION_DAYS": "30",
        "MIN_PAYOUT_USD_CENTS": "1000",
        "MIN_PAYOUT_VND": "250000",
        // AI moderation auto-approves low-risk changes; everything else waits for the operator over /operator/mcp.
        "MODERATION_MODE": "ai",
        "MODERATION_DECISION_PROVIDER": "cloudflare",
        "MODERATION_DECISION_MODEL_FAST": "clef",
        "MODERATION_DECISION_MODEL": "clef",
        "MODERATION_LLM_PROVIDER": "cloudflare",
        "MODERATION_LLM_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
        "MODERATION_APPROVE_MAX_RISK": "0.3",
        "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
        "SEPAY_API_BASE": "https://pgapi-sandbox.sepay.vn",
        "SEPAY_CHECKOUT_URL": "https://pay-sandbox.sepay.vn/v1/checkout/init",
        "EMAIL_FROM": "bip.ad <hello@bip.ad>",
        "EMAIL_REPLY_TO": "hello@bip.ad"
      }
    }
  }
}
