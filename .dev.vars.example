# Copy to .dev.vars for `wrangler dev`. In production push each value with `wrangler secret put NAME`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte strings.
SESSION_SECRET=
OPERATOR_TOKEN=
# Only needed when PAYMENT_MODE=sandbox|live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
# AI moderation (MODERATION_MODE=manual|ai). Workers AI runs on its own Cloudflare account over REST.
AI_CLOUDFLARE_ACCOUNT_ID=
AI_CLOUDFLARE_API_TOKEN=
# Only when MODERATION_DECISION_PROVIDER / MODERATION_LLM_PROVIDER point elsewhere.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
